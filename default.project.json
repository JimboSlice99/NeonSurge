{
  "name": "SurgeGarden",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 55,
        "CameraMinZoomDistance": 12,
        "CharacterWalkSpeed": 20,
        "CharacterJumpPower": 50
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.57, 0.6, 0.52],
        "Brightness": 2.3,
        "ClockTime": 15.5,
        "FogColor": [0.7, 0.78, 0.82],
        "FogEnd": 700,
        "FogStart": 280,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.6, 0.64, 0.56],
        "Technology": "ShadowMap"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [0.78, 0.84, 0.72],
          "Decay": [0.5, 0.52, 0.42],
          "Density": 0.2,
          "Glare": 0.12,
          "Haze": 0.7,
          "Offset": 0.04
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.03,
          "Contrast": 0.1,
          "Saturation": 0.15,
          "TintColor": [1.03, 1.0, 0.95]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.08,
          "Spread": 0.6
        }
      }
    },

    "SoundService": {
      "$properties": {
        "AmbientReverb": "Forest",
        "DopplerScale": 1,
        "RespectFilteringEnabled": true
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.37, 0.65, 0.86],
          "Material": "SmoothPlastic",
          "Position": [0, -20, 200],
          "Size": [2048, 1, 2048],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    }
  }
}
