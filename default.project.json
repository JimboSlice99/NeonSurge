{
  "name": "NeonSurge",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 32,
        "CameraMinZoomDistance": 14,
        "CharacterWalkSpeed": 24,
        "CharacterJumpPower": 50
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.08, 0.09, 0.14],
        "Brightness": 0.85,
        "ClockTime": 0.3,
        "ExposureCompensation": 0.15,
        "FogColor": [0.02, 0.03, 0.07],
        "FogEnd": 180,
        "FogStart": 55,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.1, 0.11, 0.18],
        "Technology": "ShadowMap"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [0.08, 0.1, 0.18],
          "Decay": [0.2, 0.12, 0.28],
          "Density": 0.32,
          "Glare": 0.05,
          "Haze": 1.8,
          "Offset": 0.2
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": -0.04,
          "Contrast": 0.18,
          "Saturation": -0.05,
          "TintColor": [0.85, 0.92, 1.05]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.35,
          "Size": 18,
          "Threshold": 1.4
        }
      },
      "DepthOfField": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "FarIntensity": 0.15,
          "FocusDistance": 40,
          "InFocusRadius": 28,
          "NearIntensity": 0.05
        }
      }
    },

    "SoundService": {
      "$properties": {
        "AmbientReverb": "ConcertHall",
        "DopplerScale": 1,
        "RespectFilteringEnabled": true
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.05, 0.06, 0.1],
          "Material": "SmoothPlastic",
          "Position": [0, -0.5, 0],
          "Size": [220, 1, 220],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Duration": 0,
          "Neutral": true,
          "Color": [0.1, 0.35, 0.45],
          "Material": "SmoothPlastic",
          "Position": [0, 0.5, 14],
          "Size": [8, 1, 8],
          "Transparency": 0.35,
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    }
  }
}
