        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.12, 0.16, 0.28],
          "Material": "SmoothPlastic",
          "Position": [0, -0.5, 0],
          "Size": [200, 1, 200],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Duration": 0,
          "Neutral": true,
          "Color": [0, 0.85, 1],
          "Material": "Neon",
          "Position": [0, 0.5, 0],
          "Size": [12, 1, 12],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
