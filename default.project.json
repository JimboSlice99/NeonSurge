{
  "name": "NeonSurge",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 28,
        "CameraMinZoomDistance": 12,
        "CharacterWalkSpeed": 22,
        "CharacterJumpPower": 50
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.25, 0.28, 0.4],
        "Brightness": 2.2,
        "ClockTime": 20,
        "FogColor": [0.05, 0.08, 0.18],
        "FogEnd": 400,
        "FogStart": 120,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.2, 0.22, 0.35],
        "Technology": "ShadowMap"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [0.2, 0.28, 0.5],
          "Decay": [0.25, 0.18, 0.4],
          "Density": 0.18,
          "Glare": 0.15,
          "Haze": 0.6,
          "Offset": 0.05
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.05,
          "Contrast": 0.12,
          "Saturation": 0.2,
          "TintColor": [0.95, 0.98, 1.1]
