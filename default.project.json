{
  "name": "SurgeGarden",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 40,
        "CameraMinZoomDistance": 10,
        "CharacterWalkSpeed": 18,
        "CharacterJumpPower": 50
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.55, 0.58, 0.5],
        "Brightness": 2,
        "ClockTime": 14,
        "FogColor": [0.7, 0.78, 0.85],
        "FogEnd": 420,
        "FogStart": 180,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.58, 0.62, 0.55],
        "Technology": "ShadowMap"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [0.75, 0.82, 0.7],
          "Decay": [0.55, 0.55, 0.45],
          "Density": 0.22,
          "Glare": 0.1,
          "Haze": 0.8,
          "Offset": 0.05
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.08,
          "Saturation": 0.12,
          "TintColor": [1.02, 1.0, 0.96]
        }
      }
    },

    "SoundService": {
      "$properties": {
        "AmbientReverb": "Forest",
        "DopplerScale": 1,
        "RespectFilteringEnabled": true
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.35, 0.62, 0.86],
          "Material": "SmoothPlastic",
          "Position": [0, -6, 0],
          "Size": [512, 1, 512],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    }
  }
}
