{
  "name": "NeonSurge",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": { "$path": "src/ReplicatedStorage" },
    "ServerScriptService": { "$path": "src/ServerScriptService" },
    "StarterPlayer": {
      "StarterPlayerScripts": { "$path": "src/StarterPlayer/StarterPlayerScripts" },
      "$properties": {
        "CameraMaxZoomDistance": 80,
        "CameraMinZoomDistance": 20,
        "CharacterWalkSpeed": 20
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.07, 0.08, 0.12],
        "Brightness": 0.8,
        "ClockTime": 0.25,
        "FogColor": [0.02, 0.03, 0.06],
        "FogEnd": 220,
        "FogStart": 70,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.1, 0.11, 0.16],
        "Technology": "ShadowMap"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.25,
          "Haze": 1.4,
          "Glare": 0.04,
          "Color": [0.08, 0.1, 0.16],
          "Decay": [0.16, 0.1, 0.24]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.25,
          "Size": 14,
          "Threshold": 1.45
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": -0.04,
          "Contrast": 0.16,
          "Saturation": -0.06,
          "TintColor": [0.88, 0.93, 1.05]
        }
      }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.05, 0.06, 0.1],
          "Size": [220, 1, 180],
          "Position": [0, -0.5, 0],
          "Material": "SmoothPlastic"
        }
      }
    }
  }
}
