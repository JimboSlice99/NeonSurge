{
  "name": "NeonSurge",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage"
    },

    "ServerScriptService": {
      "$path": "src/ServerScriptService"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      },
      "$properties": {
        "CameraMaxZoomDistance": 28,
        "CameraMinZoomDistance": 12,
        "CharacterWalkSpeed": 22,
        "CharacterJumpPower": 50
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0.05, 0.08, 0.18],
        "Brightness": 1.4,
        "ClockTime": 0,
        "FogColor": [0.02, 0.04, 0.12],
        "FogEnd": 220,
        "FogStart": 40,
        "GlobalShadows": true,
        "OutdoorAmbient": [0.08, 0.1, 0.22],
        "Technology": "ShadowMap"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [0.12, 0.18, 0.4],
          "Decay": [0.35, 0.2, 0.55],
          "Density": 0.35,
          "Glare": 0.2,
          "Haze": 1.4,
          "Offset": 0.1
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.02,
          "Contrast": 0.15,
          "Saturation": 0.25,
          "TintColor": [0.9, 0.95, 1.1]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.85,
          "Size": 28,
          "Threshold": 0.9
        }
      }
    },

    "SoundService": {
      "$properties": {
        "AmbientReverb": "City",
        "DopplerScale": 1,
        "RespectFilteringEnabled": true
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Color": [0.03, 0.04, 0.08],
          "Material": "SmoothPlastic",
          "Position": [0, -0.5, 0],
          "Size": [200, 1, 200],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    }
  }
}
